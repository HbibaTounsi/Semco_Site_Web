@using SiteWeb.Application.DTOs.Category
@model IReadOnlyList<CategoryDto>
@{
    ViewData["Title"] = "Nos Catégories d'Emballage";
}

<div class="bg-light py-4 border-bottom">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted"><i class="bi bi-house-door me-1"></i>Accueil</a></li>
                <li class="breadcrumb-item active" aria-current="page">Nos catégories</li>
            </ol>
        </nav>
        <h1 class="fw-bold mb-1">Nos Catégories d'Emballage</h1>
        <p class="text-muted mb-0">Découvrez l'ensemble de nos gammes de produits conçues pour le conditionnement, la fermeture et la palettisation.</p>
    </div>
</div>

<div class="container py-5">
    <div class="row g-4">
        @foreach (var category in Model)
        {
            <div class="col-lg-4 col-md-6">
                <div class="category-card">
                    <div class="category-card-img-wrapper">
                        <img src="@(string.IsNullOrEmpty(category.ImageUrl) ? "/images/etiquette.png" : category.ImageUrl)" alt="@category.Name" loading="lazy" />
                    </div>
                    <div class="p-4 d-flex flex-column flex-grow-1">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h2 class="fs-4 fw-bold text-dark mb-0">@category.Name</h2>
                            <span class="badge-category"><i class="bi bi-box me-1"></i> @category.ProductCount produits</span>
                        </div>
                        <p class="text-muted small flex-grow-1 mb-4">
                            @category.Description
                        </p>
                        <div class="d-flex gap-2">
                            <a asp-controller="Products" asp-action="Category" asp-route-slug="@category.Slug" class="btn btn-semco-primary w-100">
                                <i class="bi bi-arrow-right-circle me-1"></i> Consulter les produits
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Need assistance block -->
    <div class="mt-5 p-4 rounded-4 bg-white border text-center">
        <h4 class="fw-bold mb-2">Vous cherchez une dimension ou un produit spécifique ?</h4>
        <p class="text-muted mb-3">SEMCO réalise également des fabrications spéciales et de l'impression sur mesure pour vos emballages.</p>
        <a asp-controller="Contact" asp-action="Index" class="btn btn-semco-orange">
            <i class="bi bi-telephone-outbound me-1"></i> Contacter un conseiller technique
        </a>
    </div>
</div>
