<footer class="site-footer">
    <div class="container">
        <div class="row g-4">
            <!-- Company Info & Logo -->
            <div class="col-lg-4 col-md-6">
                <div class="mb-3">
                    <img src="~/images/logo-semco.jpg" alt="SEMCO Service Emballage Confort" style="height: 52px; background: white; border-radius: 8px; padding: 4px;" onerror="this.src='/images/logo.svg'" />
                </div>
                <p class="text-secondary mb-4 pe-lg-3">
                    <strong>SEMCO — Service Emballage Confort</strong> est votre partenaire de confiance pour la fourniture industrielle de films étirables, rubans adhésifs, étiquettes, sacs d'emballage et machines de conditionnement.
                </p>
                <div class="d-flex gap-2">
                    <a href="https://wa.me/33123456789" target="_blank" class="btn btn-sm btn-whatsapp">
                        <i class="bi bi-whatsapp"></i> Échanger sur WhatsApp
                    </a>
                </div>
            </div>

            <!-- Quick Navigation -->
            <div class="col-lg-2 col-md-6 col-6">
                <h5>Navigation</h5>
                <ul class="list-unstyled d-flex flex-column gap-2">
                    <li><a asp-controller="Home" asp-action="Index"><i class="bi bi-chevron-right me-1 small"></i> Accueil</a></li>
                    <li><a asp-controller="Products" asp-action="Index"><i class="bi bi-chevron-right me-1 small"></i> Nos produits</a></li>
                    <li><a asp-controller="Categories" asp-action="Index"><i class="bi bi-chevron-right me-1 small"></i> Nos catégories</a></li>
                    <li><a asp-controller="About" asp-action="Index"><i class="bi bi-chevron-right me-1 small"></i> À propos</a></li>
                    <li><a asp-controller="Contact" asp-action="Index"><i class="bi bi-chevron-right me-1 small"></i> Contact & Devis</a></li>
                </ul>
            </div>

            <!-- Categories -->
            <div class="col-lg-3 col-md-6 col-6">
                <h5>Nos Catégories</h5>
                <ul class="list-unstyled d-flex flex-column gap-2">
                    <li><a asp-controller="Products" asp-action="Category" asp-route-slug="film"><i class="bi bi-layers me-1 small"></i> Film Étirable & Bulles</a></li>
                    <li><a asp-controller="Products" asp-action="Category" asp-route-slug="scotch"><i class="bi bi-tape me-1 small"></i> Rubans Adhésifs & Scotch</a></li>
                    <li><a asp-controller="Products" asp-action="Category" asp-route-slug="etiquettes"><i class="bi bi-tag me-1 small"></i> Étiquettes & Signalétique</a></li>
                    <li><a asp-controller="Products" asp-action="Category" asp-route-slug="machines"><i class="bi bi-gear me-1 small"></i> Machines & Banderoleuses</a></li>
                    <li><a asp-controller="Products" asp-action="Category" asp-route-slug="sacs"><i class="bi bi-bag me-1 small"></i> Sacs Kraft & Pochettes</a></li>
                </ul>
            </div>

            <!-- Contact info -->
            <div class="col-lg-3 col-md-6">
                <h5>Coordonnées</h5>
                <ul class="list-unstyled d-flex flex-column gap-3 text-secondary">
                    <li class="d-flex align-items-start gap-2">
                        <i class="bi bi-geo-alt-fill text-warning fs-5"></i>
                        <span>Zone Industrielle de l'Emballage<br />75000 Paris, France</span>
                    </li>
                    <li class="d-flex align-items-center gap-2">
                        <i class="bi bi-telephone-fill text-primary fs-5"></i>
                        <span><a href="tel:+33123456789" class="text-white">+33 1 23 45 67 89</a></span>
                    </li>
                    <li class="d-flex align-items-center gap-2">
                        <i class="bi bi-envelope-fill text-warning fs-5"></i>
                        <span><a href="mailto:contact@semco-emballage.fr" class="text-white">contact@semco-emballage.fr</a></span>
                    </li>
                    <li class="d-flex align-items-center gap-2">
                        <i class="bi bi-clock-fill text-info fs-5"></i>
                        <span>Lun - Ven : 08h00 - 18h00</span>
                    </li>
                </ul>
            </div>
        </div>

        <div class="footer-bottom d-flex flex-column flex-md-row justify-content-between align-items-center gap-2 text-center text-md-start">
            <p class="mb-0 text-muted">&copy; @DateTime.UtcNow.Year SEMCO — Service Emballage Confort. Tous droits réservés.</p>
            <div class="d-flex gap-3 small">
                <span class="text-muted">Catalogue professionnel B2B</span>
                <span class="text-muted">&bull;</span>
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="text-muted">Espace Gestion</a>
            </div>
        </div>
    </div>
</footer>
