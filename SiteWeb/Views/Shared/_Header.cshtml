<header>
    <!-- Top info bar -->
    <div class="top-bar d-none d-md-block">
        <div class="container d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-4">
                <span><i class="bi bi-geo-alt-fill text-warning me-1"></i> Solutions & Matériel d'Emballage Industriel</span>
                <span><i class="bi bi-clock-fill text-info me-1"></i> Lun - Ven : 08h00 - 18h00</span>
            </div>
            <div class="d-flex align-items-center gap-3">
                <a href="tel:+33123456789"><i class="bi bi-telephone-fill me-1 text-primary"></i> +33 1 23 45 67 89</a>
                <a href="mailto:contact@semco-emballage.fr"><i class="bi bi-envelope-fill me-1 text-warning"></i> contact@semco-emballage.fr</a>
                <a href="https://wa.me/33123456789" target="_blank" class="text-success fw-bold"><i class="bi bi-whatsapp me-1"></i> WhatsApp Pro</a>
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="badge bg-secondary text-white text-decoration-none ms-2"><i class="bi bi-shield-lock-fill me-1"></i> Administration</a>
            </div>
        </div>
    </div>

    <!-- Main Navigation Bar -->
    <nav class="navbar navbar-expand-lg navbar-semco sticky-top">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                <img src="~/images/logo-semco.jpg" alt="SEMCO Service Emballage Confort" class="navbar-brand-logo me-2" onerror="this.src='/images/logo.svg'" />
            </a>

            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSemcoContent" aria-controls="navbarSemcoContent" aria-expanded="false" aria-label="Menu de navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarSemcoContent">
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house-door me-1"></i> Accueil
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Products" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" asp-controller="Products" asp-action="Index">
                            <i class="bi bi-grid-3x3-gap me-1"></i> Nos produits
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Categories" ? "active" : "")" asp-controller="Categories" asp-action="Index">
                            <i class="bi bi-folder2-open me-1"></i> Nos catégories
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "About" ? "active" : "")" asp-controller="About" asp-action="Index">
                            <i class="bi bi-info-circle me-1"></i> À propos
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Contact" ? "active" : "")" asp-controller="Contact" asp-action="Index">
                            <i class="bi bi-envelope me-1"></i> Contact
                        </a>
                    </li>
                </ul>

                <div class="d-flex align-items-center gap-2">
                    <a asp-controller="Contact" asp-action="Index" class="btn btn-semco-orange">
                        <i class="bi bi-chat-quote-fill me-1"></i> Nous contacter
                    </a>
                </div>
            </div>
        </div>
    </nav>
</header>
