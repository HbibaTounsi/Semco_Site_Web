@model ProductDetailViewModel
@{
    var product = Model.Product;
    ViewData["Title"] = $"{product.Name} (Réf: {product.Reference})";
    string whatsAppMessage = Uri.EscapeDataString($"Bonjour SEMCO, je souhaite avoir des informations et une offre tarifaire concernant le produit : {product.Name} (Référence : {product.Reference}).");
}

<div class="bg-light py-4 border-bottom">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted"><i class="bi bi-house-door me-1"></i>Accueil</a></li>
                <li class="breadcrumb-item"><a asp-controller="Products" asp-action="Index" class="text-decoration-none text-muted">Produits</a></li>
                <li class="breadcrumb-item"><a asp-controller="Products" asp-action="Category" asp-route-slug="@product.CategorySlug" class="text-decoration-none text-muted">@product.CategoryName</a></li>
                <li class="breadcrumb-item active" aria-current="page">@product.Name</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container py-5">
    <div class="row g-5">
        <!-- Left: Product Image -->
        <div class="col-lg-6">
            <div class="product-detail-img-box text-center position-relative">
                @if (product.IsFeatured)
                {
                    <span class="position-absolute top-0 start-0 m-3 badge-featured">
                        <i class="bi bi-star-fill me-1"></i> Recommandé SEMCO
                    </span>
                }
                <img src="@(string.IsNullOrEmpty(product.ImageUrl) ? "/images/film-etirable.png" : product.ImageUrl)" alt="@product.Name" class="img-fluid" />
            </div>

            <!-- Trust highlights under photo -->
            <div class="row g-3 mt-3">
                <div class="col-6">
                    <div class="p-3 bg-white border rounded-3 text-center">
                        <i class="bi bi-truck text-primary fs-4 d-block mb-1"></i>
                        <span class="small fw-bold">Expédition Rapide</span>
                        <span class="d-block text-muted small">Sous 24/48h</span>
                    </div>
                </div>
                <div class="col-6">
                    <div class="p-3 bg-white border rounded-3 text-center">
                        <i class="bi bi-shield-check text-success fs-4 d-block mb-1"></i>
                        <span class="small fw-bold">Qualité Garantie</span>
                        <span class="d-block text-muted small">Conforme normes CE</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right: Information & Technical Specifications -->
        <div class="col-lg-6">
            <div class="d-flex align-items-center gap-2 mb-2">
                <a asp-controller="Products" asp-action="Category" asp-route-slug="@product.CategorySlug" class="badge-category text-decoration-none">
                    <i class="bi bi-folder-fill me-1"></i> @product.CategoryName
                </a>
                <span class="badge bg-light text-secondary border">
                    Réf : <strong class="text-dark">@product.Reference</strong>
                </span>
            </div>

            <h1 class="fw-bold mb-3">@product.Name</h1>
            <p class="lead text-muted mb-4">@product.ShortDescription</p>

            <!-- CTA Contact Priority Box -->
            <div class="p-4 rounded-4 mb-4" style="background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%); border: 2px solid var(--semco-orange);">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="bi bi-tag-fill text-warning fs-5"></i>
                    <h5 class="fw-bold text-dark mb-0">Tarif professionnel & Devis sur mesure</h5>
                </div>
                <p class="small text-muted mb-3">
                    Nos tarifs sont établis en fonction des volumes demandés, des fréquences de livraison et des conditionnements souhaités. Contactez-nous pour recevoir une proposition commerciale immédiate.
                </p>
                <div class="d-flex flex-column flex-sm-row gap-3">
                    <a asp-controller="Contact" asp-action="Index" asp-route-productRef="@product.Reference" asp-route-productName="@product.Name" class="btn btn-semco-orange btn-lg flex-grow-1">
                        <i class="bi bi-envelope-paper-fill me-2"></i> Demander des informations
                    </a>
                    <a href="https://wa.me/33123456789?text=@whatsAppMessage" target="_blank" class="btn btn-whatsapp btn-lg">
                        <i class="bi bi-whatsapp"></i> WhatsApp
                    </a>
                </div>
            </div>

            <!-- Technical Specifications Table -->
            <h4 class="fw-bold mb-3 mt-4"><i class="bi bi-sliders me-2 text-primary"></i>Caractéristiques Techniques</h4>
            <div class="table-responsive bg-white border rounded-3 overflow-hidden shadow-sm mb-4">
                <table class="table specs-table table-bordered mb-0">
                    <tbody>
                        <tr>
                            <th>Référence produit</th>
                            <td class="font-monospace fw-bold">@product.Reference</td>
                        </tr>
                        <tr>
                            <th>Catégorie</th>
                            <td>@product.CategoryName</td>
                        </tr>
                        @if (!string.IsNullOrEmpty(product.Dimensions))
                        {
                            <tr>
                                <th>Dimensions / Format</th>
                                <td>@product.Dimensions</td>
                            </tr>
                        }
                        @if (!string.IsNullOrEmpty(product.Color))
                        {
                            <tr>
                                <th>Coloris / Aspect</th>
                                <td>@product.Color</td>
                            </tr>
                        }
                        @if (!string.IsNullOrEmpty(product.Material))
                        {
                            <tr>
                                <th>Matière première</th>
                                <td>@product.Material</td>
                            </tr>
                        }
                        @if (!string.IsNullOrEmpty(product.Specifications))
                        {
                            <tr>
                                <th>Spécifications techniques</th>
                                <td>@product.Specifications</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Detailed Description -->
            <h4 class="fw-bold mb-3"><i class="bi bi-file-earmark-text me-2 text-primary"></i>Description détaillée</h4>
            <div class="p-4 bg-white border rounded-3 shadow-sm text-secondary" style="line-height: 1.7;">
                @product.Description
            </div>
        </div>
    </div>

    <!-- Related Products -->
    @if (Model.RelatedProducts != null && Model.RelatedProducts.Count > 0)
    {
        <div class="mt-5 pt-5 border-top">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <span class="section-tag"><i class="bi bi-grid me-1"></i> Gamme Complémentaire</span>
                    <h3 class="fw-bold mb-0">Produits similaires dans la catégorie @product.CategoryName</h3>
                </div>
                <a asp-controller="Products" asp-action="Category" asp-route-slug="@product.CategorySlug" class="btn btn-semco-outline">
                    Voir toute la catégorie
                </a>
            </div>

            <div class="row g-4">
                @foreach (var item in Model.RelatedProducts)
                {
                    <div class="col-lg-3 col-md-6">
                        <div class="product-card">
                            <div class="product-card-img-wrapper" style="height: 180px;">
                                <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/film-etirable.png" : item.ImageUrl)" alt="@item.Name" loading="lazy" />
                            </div>
                            <div class="product-card-body p-3">
                                <span class="product-ref">@item.Reference</span>
                                <h4 class="fs-6 fw-bold text-dark mt-1 mb-2 text-truncate" title="@item.Name">@item.Name</h4>
                                <a asp-controller="Products" asp-action="Details" asp-route-slug="@item.Slug" class="btn btn-sm btn-semco-primary w-100 mt-auto">
                                    <i class="bi bi-eye me-1"></i> Voir le produit
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>
