@model ProductListViewModel
@{
    var category = Model.SelectedCategory!;
    ViewData["Title"] = $"{category.Name} - Gamme & Produits d'Emballage";
}

<!-- Category Banner Header -->
<div class="bg-light py-4 border-bottom">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted"><i class="bi bi-house-door me-1"></i>Accueil</a></li>
                <li class="breadcrumb-item"><a asp-controller="Categories" asp-action="Index" class="text-decoration-none text-muted">Catégories</a></li>
                <li class="breadcrumb-item active" aria-current="page">@category.Name</li>
            </ol>
        </nav>

        <div class="row align-items-center g-4 mt-1">
            <div class="col-lg-8">
                <span class="badge-category mb-2"><i class="bi bi-tag-fill me-1"></i> Catégorie Spécialisée</span>
                <h1 class="fw-bold display-6 mb-2">@category.Name</h1>
                <p class="lead text-muted mb-0">@category.Description</p>
            </div>
            <div class="col-lg-4 text-lg-end">
                <div class="d-inline-flex align-items-center gap-2 bg-white border p-3 rounded-4 shadow-sm">
                    <div class="feature-icon-wrapper feature-icon-blue mb-0" style="width: 45px; height: 45px; font-size: 1.2rem;">
                        <i class="bi bi-box-seam"></i>
                    </div>
                    <div class="text-start">
                        <div class="fw-bold fs-5 text-dark">@Model.Products.Count</div>
                        <div class="small text-muted">Modèles & Références</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container py-5">
    <!-- Category internal search & sort -->
    <div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-white">
        <form method="get" asp-controller="Products" asp-action="Category" asp-route-slug="@category.Slug" class="row g-3 align-items-center">
            <div class="col-lg-7 col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" value="@Model.SearchTerm" class="form-control border-start-0 bg-light" placeholder="Rechercher dans la catégorie @category.Name..." />
                </div>
            </div>

            <div class="col-lg-3 col-md-3">
                <select name="sort" class="form-select bg-light">
                    @if (string.IsNullOrEmpty(Model.SortBy))
                    {
                        <option value="" selected>Tri par défaut</option>
                    }
                    else
                    {
                        <option value="">Tri par défaut</option>
                    }
                    @if (Model.SortBy == "name_asc")
                    {
                        <option value="name_asc" selected>Nom (A-Z)</option>
                    }
                    else
                    {
                        <option value="name_asc">Nom (A-Z)</option>
                    }
                    @if (Model.SortBy == "name_desc")
                    {
                        <option value="name_desc" selected>Nom (Z-A)</option>
                    }
                    else
                    {
                        <option value="name_desc">Nom (Z-A)</option>
                    }
                    @if (Model.SortBy == "date_desc")
                    {
                        <option value="date_desc" selected>Nouveautés</option>
                    }
                    else
                    {
                        <option value="date_desc">Nouveautés</option>
                    }
                </select>
            </div>

            <div class="col-lg-2 col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-semco-primary w-100">
                    <i class="bi bi-funnel me-1"></i> Filtrer
                </button>
                @if (!string.IsNullOrEmpty(Model.SearchTerm) || !string.IsNullOrEmpty(Model.SortBy))
                {
                    <a asp-controller="Products" asp-action="Category" asp-route-slug="@category.Slug" class="btn btn-outline-secondary" title="Réinitialiser">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
            </div>
        </form>
    </div>

    <!-- Products Grid -->
    @if (Model.Products.Count == 0)
    {
        <div class="text-center py-5 my-4 bg-white rounded-4 border p-5">
            <i class="bi bi-search text-muted" style="font-size: 3rem;"></i>
            <h3 class="fw-bold mt-3">Aucun produit ne correspond à ces critères dans "@category.Name"</h3>
            <p class="text-muted">Consultez l'ensemble des références de cette catégorie ou demandez un devis sur mesure.</p>
            <a asp-controller="Products" asp-action="Category" asp-route-slug="@category.Slug" class="btn btn-semco-primary mt-2">
                <i class="bi bi-arrow-counterclockwise me-1"></i> Réinitialiser
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var prod in Model.Products)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="product-card">
                        <div class="product-card-img-wrapper">
                            @if (prod.IsFeatured)
                            {
                                <span class="position-absolute top-0 start-0 m-3 badge-featured">
                                    <i class="bi bi-star-fill me-1"></i> Populaire
                                </span>
                            }
                            <img src="@(string.IsNullOrEmpty(prod.ImageUrl) ? "/images/film-etirable.png" : prod.ImageUrl)" alt="@prod.Name" loading="lazy" />
                        </div>
                        <div class="product-card-body">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="product-ref">@prod.Reference</span>
                                <span class="badge-category">@category.Name</span>
                            </div>
                            <h2 class="product-card-title">@prod.Name</h2>
                            <p class="product-card-desc">@prod.ShortDescription</p>
                            @if (!string.IsNullOrEmpty(prod.Dimensions))
                            {
                                <div class="small text-muted mb-3">
                                    <i class="bi bi-aspect-ratio text-primary me-1"></i> @prod.Dimensions
                                </div>
                            }
                            <a asp-controller="Products" asp-action="Details" asp-route-slug="@prod.Slug" class="btn btn-semco-primary w-100 mt-auto">
                                <i class="bi bi-eye me-1"></i> Voir le produit
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Category Advice Box -->
    <div class="mt-5 p-4 p-md-5 rounded-4 bg-white border shadow-sm">
        <div class="row align-items-center g-4">
            <div class="col-lg-8">
                <span class="badge-green mb-2"><i class="bi bi-patch-question me-1"></i> Conseil d'expert SEMCO</span>
                <h3 class="fw-bold mb-2">Vous hésitez entre plusieurs références de @category.Name ?</h3>
                <p class="text-muted mb-0">Nos conseillers techniques réalisent gratuitement des audits de consommation pour vous recommander l'épaisseur, le métrage et la résistance les plus rentables pour votre activité.</p>
            </div>
            <div class="col-lg-4 text-lg-end">
                <a asp-controller="Contact" asp-action="Index" asp-route-productName="Catégorie @category.Name" class="btn btn-semco-orange btn-lg w-100">
                    <i class="bi bi-chat-quote-fill me-1"></i> Demander conseil
                </a>
            </div>
        </div>
    </div>
</div>
